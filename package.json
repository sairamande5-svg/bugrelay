{
  "name": "bugrelay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build --config apps/web/vite.config.ts && esbuild packages/sdk/index.ts --bundle --format=esm --minify --outfile=dist/sdk.js",
    "start": "node apps/api/server.ts",
    "dev": "npm run build && npm start",
    "check": "tsc --noEmit && node --test benchmarks/unit.test.ts",
    "benchmark": "npm run build && node benchmarks/run.ts",
    "demo": "playwright install chromium && npm run dev"
  },
  "dependencies": {
    "express": "^5.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "license": "MIT"
}
